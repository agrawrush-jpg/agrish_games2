# Agrish Web Server Configuration
PORT=8080
JWT_SECRET=your_super_secret_jwt_key_here

# Render backend URL
RENDER_EXTERNAL_URL=https://agrish-games2.onrender.com

# Plesk frontend URL
PLESK_FRONTEND_URL=https://www.agrawali.com.et

# Google OAuth Client ID (from Google Cloud Console -> APIs & Credentials)
# Authorized JavaScript origins must include:
# - https://www.agrawali.com.et
# - https://agrawali.com.et
# - https://agrish-games2.onrender.com
# - http://localhost:8080
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
